<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Revenda Premium — Loja & Painel Admin</title>
  <style>
    :root {
      --bg-primary: #0f172a;
      --bg-card: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #d97706;
      --accent-hover: #b45309;
      --success: #10b981;
      --border-color: #334155;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg-primary); color: var(--text-main); min-height: 100vh; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }

    .navbar { background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 1rem 0; position: sticky; top: 0; z-index: 10; }
    .nav-container { display: flex; justify-content: space-between; align-items: center; }
    .logo-area { font-weight: bold; font-size: 1.25rem; color: var(--accent); }
    .nav-links a { color: var(--text-main); text-decoration: none; margin-left: 1.5rem; cursor: pointer; }
    .cart-btn { background: var(--accent); padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-weight: bold; margin-left: 1.5rem; display: inline-block; }

    .main-content { padding-top: 2rem; padding-bottom: 3rem; }
    .view-section { display: none; }
    .view-section.active { display: block; }

    .hero { text-align: center; margin-bottom: 2rem; }
    .store-controls { margin-bottom: 1.5rem; }
    .store-controls input { width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-card); color: #fff; }

    .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
    .product-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
    .product-card img { width: 100%; height: 200px; object-fit: contain; background: #fff; padding: 0.5rem; }
    .product-info { padding: 1rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .product-title { font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-main); }
    .product-price { font-size: 1.25rem; font-weight: bold; color: var(--accent); margin-bottom: 1rem; }

    .admin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 768px) { .admin-grid { grid-template-columns: 1fr; } }

    .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.35rem; font-size: 0.875rem; color: var(--text-muted); }
    .form-group input, .form-group textarea { width: 100%; padding: 0.6rem; border-radius: 4px; border: 1px solid var(--border-color); background: #0f172a; color: #fff; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .calc-box { background: #0f172a; padding: 1rem; border-radius: 6px; margin-bottom: 1rem; border: 1px dashed var(--accent); }

    .btn { padding: 0.6rem 1.2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-success { background: var(--success); color: #fff; }

    .data-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    .data-table th, .data-table td { padding: 0.75rem; border-bottom: 1px solid var(--border-color); text-align: left; }
    .data-table img { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; }

    .text-success { color: var(--success); }
    .text-danger { color: #ef4444; }
    .text-sm { font-size: 0.85rem; color: var(--text-muted); }
    .mt-4 { margin-top: 1.5rem; }

    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); align-items: center; justify-content: center; z-index: 100; }
    .modal-content { background: var(--bg-card); padding: 2rem; border-radius: 8px; max-width: 500px; width: 90%; position: relative; }
    .close-btn { position: absolute; top: 1rem; right: 1rem; font-size: 1.5rem; cursor: pointer; }
  </style>
</head>
<body>
  <header class="navbar">
    <div class="container nav-container">
      <div class="logo-area">REVENDA PREMIUM</div>
      <nav class="nav-links">
        <a onclick="showSection('store')">Loja Virtual</a>
        <a onclick="showSection('admin')">Painel Admin</a>
        <div class="cart-btn" onclick="toggleCartModal()">🛒 Carrinho (<span id="cart-count">0</span>)</div>
      </nav>
    </div>
  </header>

  <main class="container main-content">
    <!-- LOJA -->
    <section id="section-store" class="view-section active">
      <div class="hero">
        <h1>Catálogo de Produtos</h1>
        <p>Produtos selecionados com garantia de qualidade.</p>
      </div>
      <div class="products-grid" id="products-grid"></div>
    </section>

    <!-- ADMIN -->
    <section id="section-admin" class="view-section">
      <h2>Painel Administrativo & Gestão</h2>
      <div class="admin-grid mt-4">
        <!-- Importador -->
        <div class="card">
          <h3>1. Importar do Mercado Livre</h3>
          <p class="text-sm">Cole o link do anúncio para extrair os dados autorizados via API oficial.</p>
          <div class="form-group mt-4">
            <label>URL do Anúncio</label>
            <input type="url" id="ml-url-input" placeholder="https://produto.mercadolivre.com.br/MLB-...">
          </div>
          <button class="btn btn-primary" onclick="importFromML()">Importar Anúncio</button>
          <div id="import-status" class="text-sm mt-4"></div>
        </div>

        <!-- Precificação -->
        <div class="card">
          <h3>2. Calculadora & Cadastro</h3>
          <form id="product-form" onsubmit="saveProduct(event)">
            <input type="hidden" id="p-ml-id">
            <div class="form-group">
              <label>Título do Produto</label>
              <input type="text" id="p-title" required>
            </div>
            <div class="form-group">
              <label>Custo de Aquisição (R$)</label>
              <input type="number" step="0.01" id="p-cost" required oninput="recalculatePrice()">
            </div>
            <div class="grid-2">
              <div class="form-group">
                <label>Margem (%)</label>
                <input type="number" step="0.1" id="p-margin" value="30" oninput="recalculatePrice()">
              </div>
              <div class="form-group">
                <label>Taxa Gateway (%)</label>
                <input type="number" step="0.1" id="p-gateway" value="4.99" oninput="recalculatePrice()">
              </div>
            </div>
            <div class="grid-2">
              <div class="form-group">
                <label>Impostos (%)</label>
                <input type="number" step="0.1" id="p-tax" value="6.00" oninput="recalculatePrice()">
              </div>
              <div class="form-group">
                <label>Custo Operacional (R$)</label>
                <input type="number" step="0.01" id="p-operational" value="0.00" oninput="recalculatePrice()">
              </div>
            </div>
            <div class="calc-box">
              <div>Preço Sugerido de Venda: <strong id="calc-final-price">R$ 0,00</strong></div>
              <div>Lucro Líquido Estimado: <strong id="calc-net-profit" class="text-success">R$ 0,00</strong></div>
            </div>
            <div class="form-group">
              <label>URL da Imagem Principal</label>
              <input type="url" id="p-image" required>
            </div>
            <button type="submit" class="btn btn-success">Salvar e Publicar na Loja</button>
          </form>
        </div>
      </div>

      <!-- Tabela -->
      <div class="card mt-4">
        <h3>Produtos Publicados</h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>Imagem</th>
              <th>Título</th>
              <th>Custo</th>
              <th>Preço Venda</th>
              <th>Lucro Líq.</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody id="admin-products-table"></tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Modal Carrinho -->
  <div id="cart-modal" class="modal">
    <div class="modal-content">
      <span class="close-btn" onclick="toggleCartModal()">&times;</span>
      <h2>Seu Carrinho</h2>
      <div id="cart-items" class="mt-4"></div>
      <div class="mt-4">
        <div>Subtotal: <strong id="cart-subtotal">R$ 0,00</strong></div>
        <p class="text-sm mt-4">Frete por CEP e pagamentos PIX/Cartão serão ativados nas Fases 2 e 3.</p>
      </div>
    </div>
  </div>

  <script>
    let products = JSON.parse(localStorage.getItem('store_products')) || [];
    let cart = JSON.parse(localStorage.getItem('store_cart')) || [];

    function saveState() {
      localStorage.setItem('store_products', JSON.stringify(products));
      localStorage.setItem('store_cart', JSON.stringify(cart));
    }

    function showSection(name) {
      document.querySelectorAll('.view-section').forEach(s => s.classList.remove('active'));
      document.getElementById(`section-${name}`).classList.add('active');
    }

    async function importFromML() {
      const url = document.getElementById('ml-url-input').value.trim();
      const status = document.getElementById('import-status');
      const match = url.match(/(MLB|MLB-)?(\d{8,12})/);
      
      if (!match) {
        status.className = 'text-danger mt-4';
        status.innerText = 'Link inválido. Insira um link válido de anúncio do Mercado Livre.';
        return;
      }

      const itemId = `MLB${match[2]}`;
      status.className = 'text-sm mt-4';
      status.innerText = 'Consultando API oficial do Mercado Livre...';

      try {
        const res = await fetch(`https://api.mercadolibre.com/items/${itemId}`);
        if (!res.ok) throw new Error('Anúncio não encontrado ou indisponível.');
        const item = await res.json();

        document.getElementById('p-ml-id').value = item.id;
        document.getElementById('p-title').value = item.title;
        document.getElementById('p-cost').value = item.price;
        document.getElementById('p-image').value = item.pictures && item.pictures.length ? item.pictures[0].secure_url : item.thumbnail;
        
        recalculatePrice();
        status.className = 'text-success mt-4';
        status.innerText = 'Dados importados! Ajuste as margens na calculadora ao lado.';
      } catch (err) {
        status.className = 'text-danger mt-4';
        status.innerText = err.message;
      }
    }

    function recalculatePrice() {
      const cost = parseFloat(document.getElementById('p-cost').value) || 0;
      const margin = parseFloat(document.getElementById('p-margin').value) || 0;
      const gateway = parseFloat(document.getElementById('p-gateway').value) || 0;
      const tax = parseFloat(document.getElementById('p-tax').value) || 0;
      const operational = parseFloat(document.getElementById('p-operational').value) || 0;

      const directCosts = cost + operational;
      const totalFeesPercent = (margin + gateway + tax) / 100;

      if (totalFeesPercent >= 1) {
        document.getElementById('calc-final-price').innerText = 'Erro (% >= 100%)';
        document.getElementById('calc-net-profit').innerText = 'R$ 0,00';
        return;
      }

      const finalPrice = directCosts / (1 - totalFeesPercent);
      const netProfit = finalPrice - directCosts - (finalPrice * (gateway / 100)) - (finalPrice * (tax / 100));

      document.getElementById('calc-final-price').innerText = `R$ ${finalPrice.toFixed(2)}`;
      document.getElementById('calc-net-profit').innerText = `R$ ${netProfit.toFixed(2)}`;
    }

    function saveProduct(e) {
      e.preventDefault();
      const cost = parseFloat(document.getElementById('p-cost').value) || 0;
      const margin = parseFloat(document.getElementById('p-margin').value) || 0;
      const gateway = parseFloat(document.getElementById('p-gateway').value) || 0;
      const tax = parseFloat(document.getElementById('p-tax').value) || 0;
      const operational = parseFloat(document.getElementById('p-operational').value) || 0;

      const directCosts = cost + operational;
      const finalPrice = directCosts / (1 - ((margin + gateway + tax) / 100));
      const netProfit = finalPrice - directCosts - (finalPrice * (gateway / 100)) - (finalPrice * (tax / 100));

      const newProduct = {
        id: Date.now(),
        ml_id: document.getElementById('p-ml-id').value,
        title: document.getElementById('p-title').value,
        cost: cost,
        final_price: finalPrice.toFixed(2),
        net_profit: netProfit.toFixed(2),
        image: document.getElementById('p-image').value
      };

      products.push(newProduct);
      saveState();
      renderStore();
      renderAdminTable();
      document.getElementById('product-form').reset();
      recalculatePrice();
      alert('Produto cadastrado na loja!');
    }

    function renderStore() {
      const grid = document.getElementById('products-grid');
      grid.innerHTML = products.length === 0 ? '<p class="text-sm">Nenhum produto cadastrado.</p>' : '';
      products.forEach(p => {
        grid.innerHTML += `
          <div class="product-card">
            <img src="${p.image}" alt="${p.title}">
            <div class="product-info">
              <div>
                <h3 class="product-title">${p.title}</h3>
                <div class="product-price">R$ ${parseFloat(p.final_price).toFixed(2)}</div>
              </div>
              <button class="btn btn-primary" onclick="addToCart(${p.id})">Adicionar ao Carrinho</button>
            </div>
          </div>`;
      });
    }

    function renderAdminTable() {
      const tbody = document.getElementById('admin-products-table');
      tbody.innerHTML = '';
      products.forEach(p => {
        tbody.innerHTML += `
          <tr>
            <td><img src="${p.image}"></td>
            <td>${p.title}</td>
            <td>R$ ${parseFloat(p.cost).toFixed(2)}</td>
            <td>R$ ${parseFloat(p.final_price).toFixed(2)}</td>
            <td class="text-success">R$ ${parseFloat(p.net_profit).toFixed(2)}</td>
            <td><button onclick="deleteProduct(${p.id})">Excluir</button></td>
          </tr>`;
      });
    }

    function deleteProduct(id) {
      products = products.filter(p => p.id !== id);
      saveState();
      renderStore();
      renderAdminTable();
    }

    function addToCart(id) {
      const prod = products.find(p => p.id === id);
      if (!prod) return;
      const item = cart.find(i => i.id === id);
      if (item) item.qty += 1; else cart.push({ ...prod, qty: 1 });
      saveState();
      updateCartUI();
      alert('Item adicionado ao carrinho!');
    }

    function updateCartUI() {
      document.getElementById('cart-count').innerText = cart.reduce((acc, i) => acc + i.qty, 0);
      const container = document.getElementById('cart-items');
      container.innerHTML = '';
      let subtotal = 0;
      cart.forEach(i => {
        const total = i.final_price * i.qty;
        subtotal += total;
        container.innerHTML += `<div>${i.title} (${i.qty}x) - R$ ${total.toFixed(2)}</div>`;
      });
      document.getElementById('cart-subtotal').innerText = `R$ ${subtotal.toFixed(2)}`;
    }

    function toggleCartModal() {
      const modal = document.getElementById('cart-modal');
      modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderStore();
      renderAdminTable();
      updateCartUI();
    });
  </script>
</body>
</html>
